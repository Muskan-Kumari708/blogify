<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
    <style>
      body {
        background: #0f172a;
      }
      .blog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 25px;
      }
      .blog-grid .card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      .blog-grid .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(124, 58, 237, 0.35);
      }
      .blog-grid .card img {
        width: 100%;
        height: 180px;
        object-fit: cover;
      }
      .blog-grid .btn-primary {
        background: #7c3aed;
        border-color: #7c3aed;
      }
      .blog-grid .btn-primary:hover {
        background: #6d28d9;
        border-color: #6d28d9;
      }
    </style>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-9">
      <div class="blog-grid">
        <% blogs.forEach(blog => { %>
        <div class="card">
          <img src="<%= blog.coverImageURL %>" class="card-img-top" />
          <div class="card-body">
            <h5 class="card-title"><%= blog.title %></h5>
            <a href="/blog/<%= blog._id %>" class="btn btn-primary mt-3">View</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include('./partials/scripts') %>
  </body>
</html>