<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
      <h1><%= blog.title %></h1>
      <img src="<%= blog.coverImageURL %>" width="700px" />
      <pre class="mt-3"><%= blog.body %></pre>
    </div>

    <div class="container mt-4">
      <span
        class="d-inline-block rounded-circle overflow-hidden align-middle"
        style="width: 35px; height: 35px"
      >
        <img
          src="<%= blog.createdBy.profileImageURL %>"
          style="width: 100%; height: 100%; object-fit: cover; transform: scale(1.3)"
        />
      </span>
      <%= blog.createdBy.fullName %>
    </div>

    <div class="container mt-3">
      <h1>Comments (<%= comments.length %>)</h1>
      <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <input
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter your comment"
          />
          <button class="btn btn-primary mt-3" style="background-color:#0d6efd; border-color:#0d6efd;" type="submit">Add</button>
        </div>
      </form>
      <% } %>

      <div class="mt-3">
        <% comments.forEach(comment => { %>
        <div>
          <span
            class="d-inline-block rounded-circle overflow-hidden align-middle"
            style="width: 35px; height: 35px"
          >
            <img
              src="<%= comment.createdBy.profileImageURL %>"
              style="width: 100%; height: 100%; object-fit: cover; transform: scale(1.3)"
            />
          </span>
          <%= comment.createdBy.fullName %>
          <pre><%= comment.content %></pre>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include('./partials/scripts') %>
  </body>
</html>