<style>
  .brand-logo {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    font-family: "Poppins", "Segoe UI", sans-serif;
    background: linear-gradient(90deg, #ffffff, #fde68a);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 2px 10px rgba(255, 255, 255, 0.25);
    transition: transform 0.2s;
  }
  .brand-logo:hover {
    transform: scale(1.06);
  }
  .custom-toggler {
  border: 2px solid rgba(255, 255, 255, 0.7);
  border-radius: 10px;
  padding: 6px 10px;
  background: rgba(255, 255, 255, 0.12);
  transition: all 0.2s;
}
.custom-toggler:hover {
  background: rgba(255, 255, 255, 0.25);
  transform: scale(1.05);
}
.nav-custom {
  color: rgba(255, 255, 255, 0.75) !important;
  font-weight: 600;
  transition: color 0.2s;
}
.nav-custom:hover {
  color: #ffffff !important;
}
 
</style>

<nav
  class="navbar navbar-expand-lg sticky-top"
  data-bs-theme="dark"
  style="background: linear-gradient(90deg, #4f46e5, #7c3aed);"
>
  <div class="container-fluid">
    <a class="navbar-brand brand-logo" href="/">Blogify</a>
   <button
  class="navbar-toggler custom-toggler"
  type="button"
  data-bs-toggle="collapse"
  data-bs-target="#navbarNavDropdown"
  aria-controls="navbarNavDropdown"
  aria-expanded="false"
  aria-label="Toggle navigation"
>
  <span class="navbar-toggler-icon"></span>
</button>
    <div class="collapse navbar-collapse" id="navbarNavDropdown">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link active nav-custom:hover" aria-current="page" href="/">Home</a>
        </li>
        <% if (locals.user) { %>
        <li class="nav-item">
          <a class="nav-link nav-custom" href="/blog/add-new">Add Blog</a> 
        </li>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle nav-custom"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <%= locals.user.fullName %>
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item " href="/user/logout">Logout</a></li>
          </ul>
        </li>
        <% } else {%>
        <li class="nav-item">
          <a class="nav-link nav-custom" href="/user/signup">Create Account</a>
        </li>
        <li class="nav-item">
          <a class="nav-link nav-custom" href="/user/signin">Signin</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
<div class="container mt-4">
  <div class="alert alert-danger" role="alert"><%= locals.error %></div>
</div>
<% } %>